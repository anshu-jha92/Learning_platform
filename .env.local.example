# Copy this file to .env.local and fill it in.
# .env.local is gitignored - never commit real secrets.

# ============================================================================
# OPTION A - Free: Groq for everything
# ============================================================================
# Groq has a free tier and speaks the OpenAI wire format, so only the URL and
# key change - no code does. It covers both coaching and speech-to-text.
#
#   Key: https://console.groq.com/keys
#
# OPENAI_BASE_URL=https://api.groq.com/openai/v1
# OPENAI_API_KEY=<your Groq key>
# OPENAI_MODEL=openai/gpt-oss-120b
# OPENAI_STT_MODEL=whisper-large-v3
#
# Groq has no text-to-speech enabled by default (its Orpheus voice needs terms
# accepted in the console first), so replies use the browser's own voice.
# Nothing to configure - the app detects it and falls back.
#
# Live calls (/live) need OpenAI specifically and will not work on this setup.
#
# NOTE ON GEMINI: its OpenAI-compatible endpoint works the same way, but its
# free tier is not available for every project or region - it may answer 403
# "free tier is not available for this project, please set up billing". Worth
# trying, but Groq is the dependable free option.
#
# OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# OPENAI_API_KEY=<your Gemini key from aistudio.google.com/apikey>
# OPENAI_MODEL=gemini-flash-latest
#
# Two providers at once also works - text and speech are separate clients:
# OPENAI_SPEECH_BASE_URL=https://api.groq.com/openai/v1
# OPENAI_SPEECH_API_KEY=<your Groq key>

# ============================================================================
# OPTION B - Paid: OpenAI for everything
# ============================================================================
# Leave OPENAI_BASE_URL unset and the app talks to OpenAI directly.
# Set a spend limit in your dashboard before you start.

OPENAI_API_KEY=

OPENAI_MODEL=gpt-4o
OPENAI_STT_MODEL=whisper-1
OPENAI_TTS_MODEL=tts-1

# Live calls. Endpoints here have moved before; if a call fails to start,
# check the current OpenAI docs and override these.
OPENAI_REALTIME_MODEL=gpt-4o-realtime-preview
OPENAI_REALTIME_SESSIONS_URL=https://api.openai.com/v1/realtime/sessions
OPENAI_REALTIME_URL=https://api.openai.com/v1/realtime

# ============================================================================
# OPTION C - No key at all
# ============================================================================
# Leave OPENAI_API_KEY blank in development and the app uses a built-in rule
# engine. Real corrections for ~11 common mistakes, zero cost, and a banner
# saying so. Force it either way with MOCK_AI=1 or MOCK_AI=0.

# ============================================================================
# Database - MongoDB Atlas
# ============================================================================
# Set: profile, history, review deck, library and tests all live in MongoDB, so
# they survive a deploy and every device sees the same data.
# Blank: everything is kept in JSON files in data/ on this machine.
#
#   Atlas -> Database -> Connect -> Drivers gives you the connection string.
#   Atlas -> Network Access must allow the machine the server runs on
#   (0.0.0.0/0 for a host like Render, whose IP addresses change).
#
# Already have data in data/? Copy it across once with: npm run db:migrate
MONGODB_URI=
# Database name inside the cluster. Defaults to english_coach.
MONGODB_DB=english_coach

# ============================================================================
# Auth
# ============================================================================
# One shared passcode unlocks the app. Blank in development means no gate; in
# production a blank passcode LOCKS the app rather than opening it.
#   npm run passcode            generate one
#   npm run passcode -- --show  print it
APP_PASSCODE=

# Optional. The token signing key is derived from APP_PASSCODE when unset,
# which is usually what you want: changing the passcode invalidates old sessions.
AUTH_SECRET=

# Extra browser origins allowed to call the API, comma-separated. The Capacitor
# native shell origins are always allowed. Never use "*" here.
ALLOWED_ORIGINS=
